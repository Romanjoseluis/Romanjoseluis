{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 10000,
  "strategy": "NFI_X7_AI",
  "timeframe": "5m",
  "stake_currency": "USDC",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.4,
  "fiat_display_currency": "USD",
  "max_open_trades": 8,
  "force_entry_enable": true,
  "initial_state": "running",
  "startup_candle_count": 200,
  "trading_mode": "spot",
  "enable_short": false,
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 40,
      "sort_key": "quoteVolume",
      "min_value": 500000,
      "refresh_period": 1800
    },
    {
      "method": "AgeFilter",
      "min_days_listed": 30
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.001,
      "min_price": 0.0000001,
      "max_price": 100000
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    },
    {
      "method": "RangeStabilityFilter",
      "lookback_days": 10,
      "min_rate_of_change": 0.01,
      "refresh_period": 1800
    },
    {
      "method": "VolatilityFilter",
      "lookback_days": 10,
      "min_volatility": 0.02,
      "max_volatility": 0.75,
      "refresh_period": 1800
    }
  ],
  "pair_blacklist": [
    ".*(UP|DOWN|BULL|BEAR).*:USDC",
    ".*3L/USDC",
    ".*3S/USDC",
    ".*5L/USDC",
    ".*5S/USDC",
    "GIGGLE/USDC"
  ],
  "unfilledtimeout": {
    "entry": 3,
    "exit": 2,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "emergency_exit": "limit",
    "force_entry": "limit",
    "force_exit": "limit",
    "stoploss": "limit",
    "stoploss_on_exchange": false,
    "stoploss_on_exchange_interval": 60,
    "stoploss_on_exchange_limit_ratio": 0.99
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1,
    "price_last_balance": 0
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "password": "",
    "secret": "",
    "uid": "",
    "pair_whitelist": [
      "ETH/USDC",
      "BTC/USDC",
      "SOL/USDC",
      "FIL/USDC",
      "BNB/USDC",
      "XRP/USDC",
      "DOGE/USDC",
      "NEAR/USDC",
      "LTC/USDC",
      "ORDI/USDC",
      "SUI/USDC",
      "AVAX/USDC",
      "PEPE/USDC",
      "LINK/USDC",
      "TIA/USDC",
      "ADA/USDC",
      "ENA/USDC",
      "WLD/USDC",
      "WIF/USDC",
      "BONK/USDC",
      "ARB/USDC",
      "TRUMP/USDC",
      "CRV/USDC",
      "AAVE/USDC",
      "BCH/USDC",
      "SHIB/USDC",
      "PNUT/USDC",
      "PENGU/USDC",
      "ETHFI/USDC",
      "UNI/USDC",
      "BOME/USDC",
      "WLFI/USDC",
      "NEO/USDC",
      "IP/USDC",
      "BIO/USDC",
      "KAITO/USDC",
      "HBAR/USDC",
      "DOT/USDC",
      "INJ/USDC",
      "OP/USDC"
    ],
    "pair_blacklist": [],
    "ccxt_config": {
      "enableRateLimit": true,
      "rateLimit": 60,
      "options": {
        "defaultType": "spot",
        "adjustForTimeDifference": true,
        "recvWindow": 10000,
        "timeDifference": 0
      }
    },
    "ccxt_async_config": {
      "enableRateLimit": true,
      "rateLimit": 60,
      "options": {
        "defaultType": "spot",
        "adjustForTimeDifference": true
      }
    }
  },
  "internals": {
    "process_throttle_secs": 3
  },
  "use_exit_signal": true,
  "ignore_roi_if_entry_signal": true,
  "stoploss": -0.99,
  "nfi_advanced_mode": true,
  "nfi_parameters": {
    "grinding_v2_max_stake": 1,
    "position_adjustment_enable": true,
    "doom_stops_enable": true,
    "grinding_v2_grind_1_profit_threshold_spot": 0.02,
    "grinding_enable": true,
    "grinding_v2_max_grinds_and_buybacks": 12,
    "derisk_enable": true,
    "stops_enable": true,
    "max_slippage": 0.015,
    "system_v3_1_stake_multiplier": 0.5,
    "stop_threshold_doom_spot": 0.2,
    "regular_mode_grind_1_profit_threshold_spot": 0.018,
    "system_name_use": "system_v3_1",
    "grinding_v2_derisk_level_1_enable": true,
    "system_v3_1_rebuy_thresholds_spot": [
      -0.09,
      -0.16,
      -0.16,
      -0.2
    ],
    "stop_threshold_rapid_spot": 0.2,
    "grinding_v2_derisk_level_1_spot": [
      -0.06,
      -0.15
    ],
    "system_v3_1_stop_threshold_doom_spot": 0.24
  },
  "bot_name": "NFI-SPOT-Backtest-AI",
  "user_data_dir": "/freqtrade/user_data",
  "datadir": "/freqtrade/user_data/data",
  "strategy_path": "/freqtrade/user_data/strategies",
  "freqai": {
    "enabled": true,
    "freqaimodel": "LightGBMRegressor",
    "identifier": "NFI_X7_FreqAI_v1",
    "purge_old_models": 2,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "live_retrain_hours": 0.0833,
    "model_path": "/freqtrade/user_data/models",
    "predictions_path": "/freqtrade/user_data/models",
    "live_training": true,
    "save_predictions": true,
    "whitelist": [
      "ETH/USDC",
      "BTC/USDC",
      "SOL/USDC",
      "FIL/USDC",
      "BNB/USDC",
      "XRP/USDC",
      "DOGE/USDC",
      "NEAR/USDC",
      "LTC/USDC",
      "ORDI/USDC",
      "SUI/USDC",
      "AVAX/USDC",
      "PEPE/USDC",
      "LINK/USDC",
      "TIA/USDC",
      "ADA/USDC",
      "ENA/USDC",
      "WLD/USDC",
      "WIF/USDC",
      "BONK/USDC",
      "ARB/USDC",
      "TRUMP/USDC",
      "CRV/USDC",
      "AAVE/USDC",
      "BCH/USDC",
      "SHIB/USDC",
      "PNUT/USDC",
      "PENGU/USDC",
      "ETHFI/USDC",
      "UNI/USDC",
      "BOME/USDC",
      "WLFI/USDC",
      "NEO/USDC",
      "IP/USDC",
      "BIO/USDC",
      "KAITO/USDC",
      "HBAR/USDC",
      "DOT/USDC",
      "INJ/USDC",
      "OP/USDC"
    ],
    "feature_parameters": {
      "include_timeframes": [
        "5m",
        "15m",
        "1h",
        "4h",
        "1d"
      ],
      "include_corr_pairlist": [
        "BTC/USDC"
      ],
      "include_static_information": false,
      "include_shifted_candles": 0,
      "indicator_periods_candles": [
        3,
        4,
        9,
        14,
        20,
        26,
        50,
        100,
        200,
        480
      ],
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "shuffle_after_split": false,
      "buffer_train_data_candles": 0,
      "label_period_candles": 12
    },
    "label_parameters": {
      "label_period_candles": 12,
      "label_name": "fai_target_entry"
    },
    "training_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "n_jobs": -1
    },
    "data_split_parameters": {
      "test_size": 0.25,
      "random_state": 42,
      "shuffle": false
    },
    "models": [
      {
        "model_name": "lgbm_reg_entry",
        "type": "LightGBMRegressor",
        "prediction_column": "fai_pred_entry",
        "target": "fai_target_entry",
        "refit_after_days": 14,
        "fit_live_predictions_candles": 1
      }
    ]
  }
}
